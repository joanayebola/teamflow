# Copy to .env and fill in real values. Never commit a filled-in .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/teamflow_dev?schema=public"
DATABASE_URL_TEST="postgresql://USER:PASSWORD@HOST:5432/teamflow_test?schema=public"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Required by Auth.js when self-hosting outside Vercel:
AUTH_TRUST_HOST=true
